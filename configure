#!/usr/bin/env bash
# configure - Detect CUDA and libcudf, generate src/Makevars

echo "Configuring cuplyr..."
echo ""

# Default paths. Remember whether CUDA_HOME came from the user: an explicit
# CUDA_HOME wins, otherwise a conda/pixi toolkit wins over a system one.
CUDA_HOME_FROM_USER="${CUDA_HOME:+1}"
CUDA_HOME="${CUDA_HOME:-/usr/local/cuda}"
CUDA_INCLUDE=""
CUDF_HOME="${CUDF_HOME:-}"
CONDA_PREFIX="${CONDA_PREFIX:-}"
CUDA_MIN_VERSION="${CUPLYR_CUDA_MIN_VERSION:-12.2}"
# Supported libcudf: CUDF_MIN_VERSION and later, with no upper bound. cuplyr
# uses RMM's cuda::mr::resource_ref model (RMM 26.02 and later); 25.12 and
# older are rejected below, before the compiler runs. CUDF_INSTALL_VERSION is
# the series cuplyr is developed and tested on, and the one install hints name.
CUDF_MIN_VERSION="26.02"
CUDF_INSTALL_VERSION="26.10"

# The conda command that installs the tested series. One definition, so the
# "not found" and "unsupported version" messages can't drift. Strict channel
# priority makes the pinned solve fail, so it is turned off; the cuda-version
# pin selects the CUDA 13 builds (the spec is quoted for the shell).
CONDA_INSTALL_CMD="mamba install --no-channel-priority -c rapidsai -c conda-forge -c nvidia libcudf=$CUDF_INSTALL_VERSION librmm=$CUDF_INSTALL_VERSION libkvikio=$CUDF_INSTALL_VERSION \"cuda-version>=13,<14\""

# Allow CUDA stub linking in non-GPU builder environments.
# Modes:
#   - explicit on: CUPLYR_ALLOW_CUDA_STUBS=1/true/yes
#   - explicit off: CUPLYR_ALLOW_CUDA_STUBS=0/false/no
#   - auto (default): enabled on common CI/builder environments
allow_cuda_stubs() {
    local mode="${CUPLYR_ALLOW_CUDA_STUBS:-auto}"
    case "$mode" in
        1|true|TRUE|yes|YES|on|ON) return 0 ;;
        0|false|FALSE|no|NO|off|OFF) return 1 ;;
    esac

    if [ -n "${CONDA_BUILD:-}" ] || [ -n "${GITHUB_ACTIONS:-}" ] || [ "${CI:-}" = "true" ] || [ "${CI:-}" = "TRUE" ] || [ "${CI:-}" = "1" ]; then
        return 0
    fi

    return 1
}

# Compare semantic versions (major.minor), returns true if current >= required.
version_at_least() {
    local current="$1"
    local required="$2"
    [ "$(printf '%s\n%s\n' "$required" "$current" | sort -V | head -n1)" = "$required" ]
}

# Detect Linux distro for remediation hints
detect_distro() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        echo "$ID"
    else
        echo "unknown"
    fi
}
DISTRO=$(detect_distro)

# The cuDF prefix CUDF_HOME points at: CUDF_HOME itself, or for a pip wheel
# (.../lib/pythonX.Y/site-packages/libcudf) the environment four levels up.
# Fails if CUDF_HOME is unset or neither holds the cudf headers.
cudf_home_prefix() {
    [ -n "$CUDF_HOME" ] && [ -d "$CUDF_HOME" ] || return 1
    if [ -f "$CUDF_HOME/include/cudf/types.hpp" ]; then
        echo "$CUDF_HOME"
        return 0
    fi
    if [[ "$CUDF_HOME" == */site-packages/libcudf ]]; then
        local pip_prefix
        pip_prefix="$(dirname "$(dirname "$(dirname "$(dirname "$CUDF_HOME")")")")"
        if [ -f "$pip_prefix/include/cudf/types.hpp" ]; then
            echo "$pip_prefix"
            return 0
        fi
    fi
    return 1
}

# Function to find libcudf
find_cudf() {
    # Check if CUDF_HOME is set first (for pip installs)
    if [ -n "$CUDF_HOME" ]; then
        if cudf_home_prefix; then
            return 0
        fi

        echo "WARNING: CUDF_HOME is set but does not look like a valid cuDF prefix: $CUDF_HOME" >&2
        echo "         Expected: \$CUDF_HOME/include/cudf/types.hpp" >&2
        echo "         If CUDF_HOME is stale, unset it and rely on CONDA_PREFIX." >&2
    fi

    # Try conda environment (check for types.hpp - the main cudf header in RAPIDS 25.x+)
    if [ -n "$CONDA_PREFIX" ] && [ -f "$CONDA_PREFIX/include/cudf/types.hpp" ]; then
        echo "$CONDA_PREFIX"
        return 0
    fi

    # Try common installation paths
    for path in /usr/local /opt/rapids /opt/conda /usr; do
        if [ -f "$path/include/cudf/types.hpp" ]; then
            echo "$path"
            return 0
        fi
    done

    return 1
}

# Detect CUDA.
#
# A system toolkit keeps everything under one CUDA_HOME. A conda or pixi
# environment splits it: headers in $CONDA_PREFIX/targets/<arch>/include,
# nvcc in $CONDA_PREFIX/bin. Prefer the environment's toolkit so the build
# uses the CUDA libcudf was built against.
find_conda_cuda_include() {
    [ -n "$CONDA_PREFIX" ] && [ -x "$CONDA_PREFIX/bin/nvcc" ] || return 1
    local target
    for target in x86_64-linux sbsa-linux; do
        if [ -f "$CONDA_PREFIX/targets/$target/include/cuda.h" ]; then
            echo "$CONDA_PREFIX/targets/$target/include"
            return 0
        fi
    done
    if [ -f "$CONDA_PREFIX/include/cuda.h" ]; then
        echo "$CONDA_PREFIX/include"
        return 0
    fi
    return 1
}

if [ -z "$CUDA_HOME_FROM_USER" ] && CONDA_CUDA_INCLUDE=$(find_conda_cuda_include); then
    CUDA_HOME="$CONDA_PREFIX"
    CUDA_INCLUDE="$CONDA_CUDA_INCLUDE"
elif [ ! -d "$CUDA_HOME" ]; then
    for cuda_path in /usr/local/cuda /opt/cuda /opt/conda/targets/x86_64-linux /usr/lib/cuda; do
        if [ -d "$cuda_path" ] && [ -f "$cuda_path/include/cuda.h" ]; then
            CUDA_HOME="$cuda_path"
            break
        fi
    done
fi
CUDA_INCLUDE="${CUDA_INCLUDE:-$CUDA_HOME/include}"

if [ ! -f "$CUDA_INCLUDE/cuda.h" ]; then
    echo "ERROR: CUDA toolkit not found."
    echo ""
    echo "Searched: CUDA_HOME=$CUDA_HOME, CONDA_PREFIX=${CONDA_PREFIX:-(unset)} and common paths"
    echo "  (/usr/local/cuda, /opt/cuda, /opt/conda/targets/x86_64-linux, /usr/lib/cuda)"
    echo ""
    echo "To fix, install the CUDA toolkit:"
    case "$DISTRO" in
        ubuntu|debian)
            echo "  sudo apt-get install nvidia-cuda-toolkit"
            echo "  # or install from NVIDIA: https://developer.nvidia.com/cuda-downloads" ;;
        fedora|rhel|centos|rocky|alma)
            echo "  sudo dnf install cuda-toolkit"
            echo "  # or install from NVIDIA: https://developer.nvidia.com/cuda-downloads" ;;
        arch|manjaro)
            echo "  sudo pacman -S cuda" ;;
        *)
            echo "  Visit: https://developer.nvidia.com/cuda-downloads" ;;
    esac
    echo ""
    echo "Or set CUDA_HOME manually:"
    echo "  export CUDA_HOME=/path/to/cuda"
    echo ""
    echo "Using pixi? Run: pixi run configure"
    exit 1
fi

if [ ! -x "$CUDA_HOME/bin/nvcc" ]; then
    echo "ERROR: nvcc not found at $CUDA_HOME/bin/nvcc."
    echo ""
    echo "This usually means the CUDA toolkit is incomplete."
    echo "Install a full toolkit (including nvcc) and retry."
    exit 1
fi

CUDA_VERSION=$("$CUDA_HOME/bin/nvcc" --version | sed -n 's/.*release \([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n1)
if [ -z "$CUDA_VERSION" ]; then
    echo "ERROR: Could not parse CUDA version from nvcc output."
    echo "Expected a 'release X.Y' entry from: $CUDA_HOME/bin/nvcc --version"
    exit 1
fi

if ! version_at_least "$CUDA_VERSION" "$CUDA_MIN_VERSION"; then
    echo "ERROR: CUDA $CUDA_VERSION found, but cuplyr requires CUDA >= $CUDA_MIN_VERSION"
    echo "       with RAPIDS libcudf >=$CUDF_MIN_VERSION."
    exit 1
fi

# Find CUDA driver library (prefer system driver libcuda.so.1 over toolkit stubs)
is_real_libcuda() {
    local lib_path="$1"

    # Reject known stub/compat locations.
    case "$lib_path" in
        *"/stubs/"*|*"/compat/"*|*"/targets/"*)
            return 1
            ;;
    esac

    # Real driver libraries are typically much larger than stubs.
    local size
    size=$(stat -Lc%s "$lib_path" 2>/dev/null || echo 0)
    if [ "$size" -lt 1000000 ]; then
        return 1
    fi

    return 0
}

find_cuda_driver_lib() {
    if command -v ldconfig >/dev/null 2>&1; then
        local driver_lib
        driver_lib=$(ldconfig -p 2>/dev/null | awk '/libcuda\.so\.1/{print $NF; exit}')
        if [ -n "$driver_lib" ] && [ -f "$driver_lib" ] && is_real_libcuda "$driver_lib"; then
            dirname "$driver_lib"
            return 0
        fi
    fi

    for path in /usr/lib64-nvidia /usr/lib/x86_64-linux-gnu /usr/lib64 /usr/lib/wsl/lib "$CUDA_HOME/lib64" "$CUDA_HOME/lib"; do
        local candidate=""
        if [ -f "$path/libcuda.so.1" ]; then
            candidate="$path/libcuda.so.1"
        elif [ -f "$path/libcuda.so" ]; then
            candidate="$path/libcuda.so"
        fi

        if [ -n "$candidate" ] && is_real_libcuda "$candidate"; then
            echo "$path"
            return 0
        fi
    done

    return 1
}

# Find CUDA stub libcuda for build-time linking when no real driver is available.
find_cuda_stub_lib() {
    local candidates=(
        "$CUDA_HOME/lib64/stubs"
        "$CUDA_HOME/lib/stubs"
        "$CUDA_HOME/targets/x86_64-linux/lib/stubs"
    )

    if [ -n "$CONDA_PREFIX" ]; then
        candidates+=(
            "$CONDA_PREFIX/lib64/stubs"
            "$CONDA_PREFIX/lib/stubs"
            "$CONDA_PREFIX/targets/x86_64-linux/lib/stubs"
        )
    fi

    for path in "${candidates[@]}"; do
        if [ -n "$path" ] && [ -d "$path" ]; then
            if [ -f "$path/libcuda.so" ] || [ -f "$path/libcuda.so.1" ]; then
                echo "$path"
                return 0
            fi
        fi
    done

    return 1
}

# Find CUDA runtime library path (libcudart)
find_cuda_runtime_lib() {
    local candidates=("$CUDA_HOME/lib64" "$CUDA_HOME/lib")
    if [ -n "$CONDA_PREFIX" ]; then
        candidates+=("$CONDA_PREFIX/lib64" "$CONDA_PREFIX/lib")
    fi

    for path in "${candidates[@]}"; do
        if [ -n "$path" ] && [ -f "$path/libcudart.so" ]; then
            echo "$path"
            return 0
        fi
    done

    return 1
}

CUDA_DRIVER_LIB=$(find_cuda_driver_lib)
CUDA_DRIVER_RPATH="$CUDA_DRIVER_LIB"
if [ -z "$CUDA_DRIVER_LIB" ]; then
    if allow_cuda_stubs; then
        CUDA_DRIVER_LIB=$(find_cuda_stub_lib)
        if [ -n "$CUDA_DRIVER_LIB" ]; then
            CUDA_DRIVER_RPATH=""
            echo "WARNING: Real libcuda.so.1 not found; using CUDA stubs for build-time linking."
            echo "         Runtime requires a real NVIDIA driver on target systems."
        fi
    fi

    if [ -z "$CUDA_DRIVER_LIB" ]; then
        echo "ERROR: libcuda.so.1 not found (NVIDIA driver library)."
        echo ""
        echo "This means the NVIDIA GPU driver is not installed or not visible."
        echo ""
        echo "To fix:"
        case "$DISTRO" in
            ubuntu|debian)
                echo "  sudo apt-get install nvidia-driver-535"
                echo "  # or use: sudo ubuntu-drivers autoinstall" ;;
            fedora|rhel|centos|rocky|alma)
                echo "  sudo dnf install nvidia-driver" ;;
            arch|manjaro)
                echo "  sudo pacman -S nvidia" ;;
            *)
                echo "  Install NVIDIA driver from: https://www.nvidia.com/Download/index.aspx" ;;
        esac
        echo ""
        echo "After installing, verify with: nvidia-smi"
        echo ""
        echo "If driver IS installed but not found, check:"
        echo "  ldconfig -p | grep libcuda"
        echo "  ls /usr/lib/x86_64-linux-gnu/libcuda.so* /usr/lib64/libcuda.so*"
        echo ""
        echo "If this is a non-GPU CI/binary builder, allow stub linking:"
        echo "  CUPLYR_ALLOW_CUDA_STUBS=1 ./configure"
        exit 1
    fi
fi

CUDA_RUNTIME_LIB=$(find_cuda_runtime_lib)
if [ -z "$CUDA_RUNTIME_LIB" ]; then
    echo "ERROR: libcudart.so not found (CUDA runtime library)."
    echo ""
    echo "Searched: CUDA_HOME=$CUDA_HOME/lib64, CONDA_PREFIX=$CONDA_PREFIX/lib"
    echo ""
    echo "This usually means the CUDA toolkit is incomplete."
    echo "Reinstall the CUDA toolkit or set CUDA_HOME to the correct path."
    echo ""
    echo "Using pixi? Run: pixi run configure"
    exit 1
fi

echo "Found CUDA at: $CUDA_HOME"
echo "Using CUDA headers at: $CUDA_INCLUDE"
echo "CUDA version: $CUDA_VERSION"
echo "Using CUDA driver link path: $CUDA_DRIVER_LIB"
if [ -n "$CUDA_DRIVER_RPATH" ]; then
    echo "Using CUDA driver runtime path: $CUDA_DRIVER_RPATH"
else
    echo "Using CUDA driver runtime path: (system default lookup)"
fi
echo "Using CUDA runtime lib path: $CUDA_RUNTIME_LIB"

# Detect libcudf
CUDF_PREFIX=$(find_cudf)
if [ -z "$CUDF_PREFIX" ]; then
    echo "ERROR: libcudf not found (RAPIDS cuDF C++ library)."
    echo ""
    echo "Searched:"
    echo "  CUDF_HOME=$CUDF_HOME"
    echo "  CONDA_PREFIX=$CONDA_PREFIX"
    echo "  /usr/local, /opt/rapids, /opt/conda, /usr"
    echo ""
    echo "Install options (pick one):"
    echo ""
    echo "  1. Recommended (pixi - handles everything):"
    echo "     pixi run install"
    echo ""
    echo "  2. Conda/Mamba:"
    echo "     $CONDA_INSTALL_CMD"
    echo "     # Then re-run: ./configure"
    echo ""
    echo "  3. Manual (set path to existing install):"
    echo "     export CUDF_HOME=/path/to/cudf"
    echo "     ./configure"
    echo ""
    echo "For more details: https://github.com/bbtheo/cuplyr#installation"
    exit 1
fi

CUDF_INCLUDE="$CUDF_PREFIX/include"

# Handle both lib and lib64 directories (FIX: check BEFORE using variable)
if [ -d "$CUDF_PREFIX/lib64" ] && [ -f "$CUDF_PREFIX/lib64/libcudf.so" ]; then
    CUDF_LIB="$CUDF_PREFIX/lib64"
else
    CUDF_LIB="$CUDF_PREFIX/lib"
fi

echo "Found libcudf at: $CUDF_PREFIX"

# Check the libcudf version before anything else is derived from it, so an
# unsupported RAPIDS fails here and not in the compiler.
read_cudf_version() {
    local header="$1"
    [ -f "$header" ] || return 1
    local major minor patch
    major=$(sed -n 's/^[[:space:]]*#[[:space:]]*define[[:space:]][[:space:]]*CUDF_VERSION_MAJOR[[:space:]][[:space:]]*\([0-9][0-9]*\).*/\1/p' "$header" | head -n1)
    minor=$(sed -n 's/^[[:space:]]*#[[:space:]]*define[[:space:]][[:space:]]*CUDF_VERSION_MINOR[[:space:]][[:space:]]*\([0-9][0-9]*\).*/\1/p' "$header" | head -n1)
    patch=$(sed -n 's/^[[:space:]]*#[[:space:]]*define[[:space:]][[:space:]]*CUDF_VERSION_PATCH[[:space:]][[:space:]]*\([0-9][0-9]*\).*/\1/p' "$header" | head -n1)
    [ -n "$major" ] && [ -n "$minor" ] || return 1
    # 10# reads zero-padded values such as 08 as decimal; %02d writes the
    # minor as RAPIDS does (26.02.0, not 26.2.0)
    printf '%d.%02d.%d\n' "$((10#$major))" "$((10#$minor))" "$((10#${patch:-0}))"
}

# major.minor as one integer (26.02 -> 26002), safe for zero-padded minors
series_key() {
    local major="${1%%.*}" minor="${1#*.}"
    echo "$((10#$major * 1000 + 10#$minor))"
}

CUDF_VERSION_HEADER="$CUDF_PREFIX/include/cudf/version_config.hpp"
if CUDF_VERSION=$(read_cudf_version "$CUDF_VERSION_HEADER"); then
    CUDF_SERIES="${CUDF_VERSION%.*}"
    if [ "$(series_key "$CUDF_SERIES")" -ge "$(series_key "$CUDF_MIN_VERSION")" ]; then
        echo "Found libcudf version: $CUDF_VERSION"
    else
        # On stderr: install.sh hides a step's stdout unless --verbose
        {
            echo "ERROR: libcudf $CUDF_VERSION found at $CUDF_PREFIX, but cuplyr needs"
            echo "       RAPIDS libcudf >=$CUDF_MIN_VERSION."
            echo ""
            echo "RAPIDS 25.12 and older use RMM's legacy memory-resource interface, which"
            echo "cuplyr no longer supports, so the build would fail."
            echo ""
            if [ -n "$CONDA_PREFIX" ]; then
                echo "To fix, install RAPIDS $CUDF_INSTALL_VERSION into the active conda environment:"
                echo "  $CONDA_INSTALL_CMD"
                echo "Or activate another conda environment that has RAPIDS $CUDF_MIN_VERSION or later,"
                echo "then re-run."
                echo ""
                # The active env's lib comes first on the runtime search path and
                # libcudf.so has no versioned soname, so CUDF_HOME must be used
                # outside conda or the build and the loaded library would differ.
                echo "For a RAPIDS $CUDF_INSTALL_VERSION install outside conda (a pip wheel or a system"
                echo "install), run \`conda deactivate\` until no environment is active, then"
                echo "point CUDF_HOME at that prefix. Otherwise the active environment's libcudf"
                echo "would be loaded instead of the one in CUDF_HOME:"
                echo "  export CUDF_HOME=/path/to/rapids-$CUDF_INSTALL_VERSION"
            else
                echo "To fix, activate (or create) a conda environment, install RAPIDS"
                echo "$CUDF_INSTALL_VERSION into it, and re-run:"
                echo "  $CONDA_INSTALL_CMD"
                echo ""
                echo "Or point CUDF_HOME at an existing RAPIDS $CUDF_MIN_VERSION (or later) prefix:"
                echo "  export CUDF_HOME=/path/to/rapids-$CUDF_INSTALL_VERSION"
            fi
            # Only when CUDF_HOME supplied this prefix and it isn't the active env
            # (-ef: the same directory, however the two paths are spelled).
            if CUDF_HOME_PREFIX=$(cudf_home_prefix) && [ "$CUDF_PREFIX" = "$CUDF_HOME_PREFIX" ] && \
               ! [ "$CUDF_PREFIX" -ef "$CONDA_PREFIX" ]; then
                echo ""
                if [ -n "$CONDA_PREFIX" ]; then
                    echo "CUDF_HOME=$CUDF_HOME is set and takes precedence over CONDA_PREFIX, so"
                    echo "installing into the active environment won't change this. Unset"
                    echo "CUDF_HOME, or run \`conda deactivate\` until no environment is active and"
                    echo "point it at a RAPIDS $CUDF_MIN_VERSION (or later) prefix."
                else
                    echo "CUDF_HOME=$CUDF_HOME is set and takes precedence, so installing"
                    echo "RAPIDS elsewhere won't change this. Unset CUDF_HOME, or"
                    echo "point it at a RAPIDS $CUDF_MIN_VERSION (or later) prefix."
                fi
            fi
        } >&2
        exit 1
    fi
else
    {
        echo "WARNING: could not read the libcudf version from $CUDF_VERSION_HEADER"
        echo "         (version_config.hpp is missing or unparseable), so the version"
        echo "         was not checked. cuplyr needs libcudf >=$CUDF_MIN_VERSION."
    } >&2
fi

# Find RMM headers - check both locations
if [ -f "$CUDF_PREFIX/include/rmm/rmm.hpp" ]; then
    RMM_INCLUDE="$CUDF_PREFIX/include"
    RMM_LIB="$CUDF_LIB"
elif [ -d "$(dirname "$CUDF_PREFIX")/librmm/include" ]; then
    RMM_INCLUDE="$(dirname "$CUDF_PREFIX")/librmm/include"
    # Check for lib64 vs lib
    if [ -d "$(dirname "$CUDF_PREFIX")/librmm/lib64" ] && [ -f "$(dirname "$CUDF_PREFIX")/librmm/lib64/librmm.so" ]; then
        RMM_LIB="$(dirname "$CUDF_PREFIX")/librmm/lib64"
    else
        RMM_LIB="$(dirname "$CUDF_PREFIX")/librmm/lib"
    fi
else
    # Fallback to libcudf paths
    RMM_INCLUDE="$CUDF_PREFIX/include"
    RMM_LIB="$CUDF_LIB"
fi

echo "Found RMM headers at: $RMM_INCLUDE"
echo "Found RMM library at: $RMM_LIB"

# Find CCCL (CUDA Core Compute Libraries) headers - needed for cuda/stream_ref
CCCL_INCLUDE=""
if [ -f "$CUDF_PREFIX/include/rapids/cuda/stream_ref" ]; then
    CCCL_INCLUDE="$CUDF_PREFIX/include/rapids"
    echo "Found CCCL headers at: $CCCL_INCLUDE"
elif [ -f "$CUDF_PREFIX/include/cuda/stream_ref" ]; then
    CCCL_INCLUDE="$CUDF_PREFIX/include"
    echo "Found CCCL headers at: $CCCL_INCLUDE (standard location)"
fi

# Find all RAPIDS library directories (for transitive dependencies)
RAPIDS_BASE="$(dirname "$CUDF_PREFIX")"
RAPIDS_RPATHS=""

append_rapids_rpath() {
    local path="$1"
    if [ -z "$path" ] || [ ! -d "$path" ]; then
        return 1
    fi
    case ":$RAPIDS_RPATHS:" in
        *":$path:"*) return 1 ;;
    esac
    if [ -z "$RAPIDS_RPATHS" ]; then
        RAPIDS_RPATHS="$path"
    else
        RAPIDS_RPATHS="$RAPIDS_RPATHS:$path"
    fi
    return 0
}

# Keep conda base lib first so transitive libstdc++ resolution prefers RAPIDS.
if [ -n "$CONDA_PREFIX" ] && [ -d "$CONDA_PREFIX/lib" ]; then
    if append_rapids_rpath "$CONDA_PREFIX/lib"; then
        echo "Added conda base library to RUNPATH: $CONDA_PREFIX/lib"
    fi
fi

append_rapids_rpath "$CUDF_LIB"
for pkg in librmm libkvikio rapids_logger; do
    for libdir in "$RAPIDS_BASE/$pkg/lib64" "$RAPIDS_BASE/$pkg/lib"; do
        if [ -d "$libdir" ]; then
            if append_rapids_rpath "$libdir"; then
                echo "Found $pkg library at: $libdir"
            fi
            break
        fi
    done
done

echo "Final RAPIDS RUNPATH directories: $RAPIDS_RPATHS"

# Verify libcudf shared library exists
if [ ! -f "$CUDF_LIB/libcudf.so" ]; then
    echo "WARNING: libcudf.so not found in $CUDF_LIB"
    echo "         Package may fail to load at runtime."
fi

# Create symlinks in CUDF_LIB for transitive dependencies (needed because libcudf uses $ORIGIN rpath)
echo "Creating symlinks for transitive dependencies..."
for lib in librmm.so libkvikio.so librapids_logger.so; do
    for pkg in librmm libkvikio rapids_logger; do
        for libdir in "$RAPIDS_BASE/$pkg/lib64" "$RAPIDS_BASE/$pkg/lib"; do
            if [ -f "$libdir/$lib" ] && [ ! -e "$CUDF_LIB/$lib" ]; then
                ln -sf "$libdir/$lib" "$CUDF_LIB/$lib" 2>/dev/null && echo "  Linked $lib -> $libdir/$lib"
            fi
        done
    done
done

CUDA_DRIVER_RPATH_FLAG=""
if [ -n "$CUDA_DRIVER_RPATH" ]; then
    CUDA_DRIVER_RPATH_FLAG="-Wl,-rpath,$CUDA_DRIVER_RPATH"
fi

# Generate Makevars from template
sed -e "s|@CUDA_HOME@|$CUDA_HOME|g" \
    -e "s|@CUDA_INCLUDE@|$CUDA_INCLUDE|g" \
    -e "s|@CUDA_DRIVER_LIB@|$CUDA_DRIVER_LIB|g" \
    -e "s|@CUDA_DRIVER_RPATH_FLAG@|$CUDA_DRIVER_RPATH_FLAG|g" \
    -e "s|@CUDA_RUNTIME_LIB@|$CUDA_RUNTIME_LIB|g" \
    -e "s|@CUDF_INCLUDE@|$CUDF_INCLUDE|g" \
    -e "s|@CUDF_LIB@|$CUDF_LIB|g" \
    -e "s|@RMM_INCLUDE@|$RMM_INCLUDE|g" \
    -e "s|@CCCL_INCLUDE@|$CCCL_INCLUDE|g" \
    -e "s|@RAPIDS_RPATHS@|$RAPIDS_RPATHS|g" \
    src/Makevars.in > src/Makevars

echo ""
echo "Configuration complete. Generated src/Makevars:"
cat src/Makevars
echo ""
echo "Run 'R CMD INSTALL .' to build the package."
