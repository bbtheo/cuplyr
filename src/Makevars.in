# Makevars.in - Template for package configuration

# CUDA and cudf paths
CUDA_HOME=@CUDA_HOME@
CUDA_INCLUDE=@CUDA_INCLUDE@
CUDA_DRIVER_LIB=@CUDA_DRIVER_LIB@
CUDA_DRIVER_RPATH_FLAG=@CUDA_DRIVER_RPATH_FLAG@
CUDA_RUNTIME_LIB=@CUDA_RUNTIME_LIB@
CUDF_INCLUDE=@CUDF_INCLUDE@
CUDF_LIB=@CUDF_LIB@
RMM_INCLUDE=@RMM_INCLUDE@
CCCL_INCLUDE=@CCCL_INCLUDE@
RAPIDS_RPATHS=@RAPIDS_RPATHS@

# Compiler flags - works for both system CUDA and conda CUDA
# LIBCUDACXX_ENABLE_EXPERIMENTAL_MEMORY_RESOURCE: RMM 26.02's headers refuse to compile
# without it (26.10 ignores it). cuplyr uses RMM's resource_ref model only, so
# the legacy-interface switch is not defined.
# IMPORTANT: CUDF/RMM/CCCL includes MUST come before CUDA_INCLUDE to use matching CCCL headers
PKG_CPPFLAGS=-DLIBCUDACXX_ENABLE_EXPERIMENTAL_MEMORY_RESOURCE $(if $(CCCL_INCLUDE),-I$(CCCL_INCLUDE),) -I$(CUDF_INCLUDE) -I$(RMM_INCLUDE) -I$(CUDA_INCLUDE)
# The deprecation flag below is empty unless configure ran with
# CUPLYR_WERROR_DEPRECATED=1, then -Werror=deprecated-declarations: a call to a
# deprecated declaration fails the compile. Deprecations are never silenced.
PKG_CXXFLAGS=@WERROR_DEPRECATED_FLAG@
PKG_LIBS=-L$(CUDF_LIB) -Wl,--enable-new-dtags -Wl,-rpath,$(RAPIDS_RPATHS) -lcudf -L$(CUDA_DRIVER_LIB) $(CUDA_DRIVER_RPATH_FLAG) -lcuda -L$(CUDA_RUNTIME_LIB) -Wl,-rpath,$(CUDA_RUNTIME_LIB) -lcudart

# C++ standard (libcudf 26.x requires C++20)
CXX_STD=CXX20
