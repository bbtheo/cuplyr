\examples{
if (has_gpu()) {
  gpu_mtcars <- tbl_gpu(mtcars)

  # Simple aggregation over all rows
  total <- gpu_mtcars |>
    summarise(avg_mpg = mean(mpg)) |>
    collect()

  # Grouped aggregation
  by_cyl <- gpu_mtcars |>
    group_by(cyl) |>
    summarise(
      avg_mpg = mean(mpg),
      max_hp = max(hp),
      count = n()
    ) |>
    collect()

  # Multiple grouping columns
  by_cyl_gear <- gpu_mtcars |>
    group_by(cyl, gear) |>
    summarise(
      mean_mpg = mean(mpg),
      min_wt = min(wt)
    ) |>
    collect()
}
}
