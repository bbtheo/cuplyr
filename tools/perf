#!/usr/bin/env bash
# Perf-regression gate under the GPU lock, always against the MAIN checkout's
# baseline (scratchpad/ is gitignored, so worktrees have no copy of their own).
#
# Observations are recorded like the merge gate does (CUPLYR_PERF_OBSERVATIONS),
# so a benchmark with no baseline entry yet is timed here too, and a broken new
# benchmark fails in the rounds rather than first at the gate. Unless the caller
# passes a path, they go to a temp file that is removed on exit; the exit status
# is the test run's.
source "$(dirname "$0")/lib.sh"
cd "$CUPLYR_WT_ROOT"
export CUPLYR_PERF_BASELINE="$CUPLYR_MAIN/scratchpad/perf_baseline.json"
if [[ -z "${CUPLYR_PERF_OBSERVATIONS:-}" ]]; then
  CUPLYR_PERF_OBSERVATIONS="$(mktemp "${TMPDIR:-/tmp}/cuplyr-perf-obs.XXXXXX")"
  export CUPLYR_PERF_OBSERVATIONS
  trap 'rm -f "$CUPLYR_PERF_OBSERVATIONS"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
fi
"$(dirname "$0")/gpu-run" --label perf -- Rscript tools/run-tests.R perf "$@"
