#!/usr/bin/env bash
# Perf-regression gate under the GPU lock, always against the MAIN checkout's
# baseline (scratchpad/ is gitignored, so worktrees have no copy of their own).
source "$(dirname "$0")/lib.sh"
cd "$CUPLYR_WT_ROOT"
export CUPLYR_PERF_BASELINE="$CUPLYR_MAIN/scratchpad/perf_baseline.json"
exec "$(dirname "$0")/gpu-run" --label perf -- Rscript tools/run-tests.R perf "$@"
